{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/bin/uvicorn main:app --reload --host 127.0.0.1 --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "presentation": { "group": "stack", "panel": "dedicated", "reveal": "silent" },
      "problemMatcher": {
        "pattern": { "regexp": "^$", "file": 1, "location": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Started server process.*",
          "endsPattern": ".*Application startup complete.*"
        }
      }
    },
    {
      "label": "frontend",
      "type": "shell",
      "command": "npm run dev -- --port 5173 --host 127.0.0.1",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "presentation": { "group": "stack", "panel": "dedicated", "reveal": "silent" },
      "problemMatcher": {
        "pattern": { "regexp": "^$", "file": 1, "location": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": ".*ready in.*"
        }
      }
    },
    {
      "label": "stack",
      "dependsOn": ["backend", "frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "test",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/bin/python -m pytest",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "hentikan stack",
      "type": "shell",
      "command": "pkill -f 'uvicorn main:app' ; pkill -f 'vite --port 5173' ; echo 'stack dihentikan'",
      "problemMatcher": []
    }
  ]
}
