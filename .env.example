APP_ENV=development
APP_NAME=SAVIRA — Smart Virtual Assistant

DATABASE_URL=postgresql://postgres:mysecretpassword@localhost:5432/agentic_rag
# User read-only khusus SQL tool (hanya SELECT pada chat_stats & documents)
SQL_READONLY_DATABASE_URL=postgresql://sva_readonly:readonly_secret@localhost:5432/agentic_rag

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

UPLOAD_DIR=./storage/uploads
PROCESSED_DIR=./storage/processed
MAX_UPLOAD_SIZE_MB=20

OCR_LANG=id
OCR_PDF_FALLBACK=true
OCR_PDF_MAX_PAGES=20
OCR_PDF_DPI=200

# Retrieval
RAG_TOP_K=4
RAG_DOC_TOP_K=12
RAG_CANDIDATE_K=20
RAG_HYBRID=true
RAG_RRF_K=60
RAG_FTS_CONFIG=indonesian

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

SQL_ALLOWED_TABLES=chat_stats,documents
SQL_QUERY_TIMEOUT_SECONDS=5
